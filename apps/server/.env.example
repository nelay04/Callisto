# @callisto/server — environment variables
# Copy to .env and fill in the values.

# ── Required ─────────────────────────────────────────────────────────────────

# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Address the send_mailto tool drafts messages to.
MAILTO_ADDRESS=your@email.com

# ── Optional (defaults shown) ────────────────────────────────────────────────

# Must be a model that supports the Live API with native audio.
GEMINI_MODEL=gemini-2.5-flash-native-audio-preview-12-2025

PORT=3001
NODE_ENV=development

# Comma-separated. Gates both CORS and WebSocket upgrades — a browser origin
# that is not listed here cannot open a session.
CORS_ORIGIN=http://localhost:3000

# Concurrent Gemini sessions allowed per client IP. Each session bills against
# your quota, so this is the guard against one caller draining it.
MAX_SESSIONS_PER_IP=3

# ── Profile links for the open_url tool ──────────────────────────────────────
# Omit either one and Callisto will say that profile isn't available.

LINKEDIN_URL=https://www.linkedin.com/in/your-profile
GITHUB_URL=https://github.com/your-username
