# @callisto/web — environment variables
# Copy to .env.local and adjust if your server isn't on localhost:3001.
#
# NEXT_PUBLIC_* values are inlined at build time, so changing either one
# requires a rebuild, not just a restart.

# WebSocket endpoint of @callisto/server (use wss:// in production).
NEXT_PUBLIC_WS_URL=ws://localhost:3001/ws/session

# REST base URL of @callisto/server.
NEXT_PUBLIC_API_URL=http://localhost:3001
