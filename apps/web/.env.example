# @callisto/web — environment variables
#
#   cp apps/web/.env.example apps/web/.env
#
# One file drives every way of running the client. There is no .env.local —
# `npm run dev` loads this file explicitly (see the web package.json scripts),
# and the Docker and Podman stacks inject it with `env_file:`.

# Port the Next.js server listens on.
#
# Next resolves --port from the environment before it loads any .env file, so
# the dev/start scripts pass this file to `node --env-file-if-exists` rather
# than relying on Next's own env loading. A PORT already exported in your shell
# still wins over this value.
PORT=3012

# ── Backend location ─────────────────────────────────────────────────────────
#
# NEXT_PUBLIC_* values are inlined at build time, so changing either one
# requires a rebuild, not just a restart. Point them at @callisto/server.
#
# Use wss:// and https:// in production.

NEXT_PUBLIC_WS_URL=ws://127.0.0.1:3013/ws/session
NEXT_PUBLIC_API_URL=http://127.0.0.1:3013
